{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mystaredia",
  "main": "worker/index.js",
  "compatibility_date": "2025-08-13",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mystaredia",
      "database_id": "478996b4-824f-49cd-a588-473f674d9302",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BRAINSHOP_BID": "156779",
    "BRAINSHOP_KEY": "0ErJYSb1ZlZmOcel"
  }
}

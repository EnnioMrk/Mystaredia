{
  "name": "mystaredia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply mystaredia --local",
    "db:remote": "wrangler d1 migrations apply mystaredia --remote",
    "check": "wrangler deploy --dry-run --outdir=.wrangler/dry"
  },
  "devDependencies": {
    "wrangler": "4.30.0"
  }
}
